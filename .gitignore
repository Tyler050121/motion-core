# MotionCore repository ignore rules
#
# Repository root:
#   motion-core/
#
# Unity project root:
#   motion-core/MotionCore/

# ----------------------------------------------------------------------
# Local agent/runtime/docs files
# ----------------------------------------------------------------------
/.omx/
/docs/
/AGENTS.md

# ----------------------------------------------------------------------
# OS generated files
# ----------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Desktop.ini

# ----------------------------------------------------------------------
# Unity generated folders
# ----------------------------------------------------------------------
/MotionCore/[Ll]ibrary/
/MotionCore/[Tt]emp/
/MotionCore/[Oo]bj/
/MotionCore/[Bb]uild/
/MotionCore/[Bb]uilds/
/MotionCore/[Ll]ogs/
/MotionCore/[Uu]ser[Ss]ettings/
/MotionCore/[Mm]emoryCaptures/
/MotionCore/[Rr]ecordings/

# ----------------------------------------------------------------------
# Unity generated files
# ----------------------------------------------------------------------
/MotionCore/sysinfo.txt
/MotionCore/mono_crash.*
/MotionCore/InitTestScene*.unity*
/MotionCore/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*
/MotionCore/[Aa]ssets/[Ss]ceneDependencyCache*

# Blender import sidecars generated by Unity
*.blend1
*.blend1.meta

# ----------------------------------------------------------------------
# MotionCore sample package imports
# Keep normal project scenes such as Assets/Scenes/SampleScene.unity tracked.
# ----------------------------------------------------------------------
/MotionCore/[Aa]ssets/[Ss]amples/
/MotionCore/[Aa]ssets/[Ss]amples.meta

# ----------------------------------------------------------------------
# Unity Addressables generated content
# ----------------------------------------------------------------------
/MotionCore/ServerData/
/MotionCore/[Aa]ssets/StreamingAssets/aa*
/MotionCore/[Aa]ssets/AddressableAssetsData/link.xml*
/MotionCore/[Aa]ssets/Addressables_Temp*
/MotionCore/[Aa]ssets/AddressableAssetsData/*/*.bin*

# ----------------------------------------------------------------------
# YooAsset generated content
# ----------------------------------------------------------------------
/MotionCore/Bundles/
/MotionCore/[Aa]ssets/StreamingAssets/yoo/
/MotionCore/[Aa]ssets/StreamingAssets/yoo.meta

# ----------------------------------------------------------------------
# Unity Visual Scripting generated content
# ----------------------------------------------------------------------
/MotionCore/[Aa]ssets/Unity.VisualScripting.Generated/

# ----------------------------------------------------------------------
# Rider / Visual Studio / VS Code / Consulo generated files
# ----------------------------------------------------------------------
.vs/
.vscode/
/MotionCore/.vs/
/MotionCore/.vscode/
/MotionCore/[Aa]ssets/Plugins/Editor/JetBrains*

*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.DotSettings.user

ExportedObj/
.consulo/
/MotionCore/ExportedObj/
/MotionCore/.consulo/

# Unity/Mono generated metadata for ignored binary artifacts
*.pidb.meta
*.pdb.meta
*.mdb.meta

# ----------------------------------------------------------------------
# Build/package artifacts
# ----------------------------------------------------------------------
*.apk
*.aab
*.app
*.ipa
*.unitypackage
*.unitypackage.meta
crashlytics-build.properties

# ----------------------------------------------------------------------
# Gradle
# ----------------------------------------------------------------------
.gradle/
/MotionCore/.gradle/
